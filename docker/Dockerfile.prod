FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip wheel --no-deps --wheel-dir /build/wheels -r requirements.txt

# ====================== Final Stage ======================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=hr_payroll.settings

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -r appuser && useradd -r -g appuser appuser

# Install Python packages from wheels
COPY --from=builder /build/wheels /wheels
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels

# Copy project code
COPY . .

# Create necessary directories and fix permissions
RUN mkdir -p /app/staticfiles /app/media /app/logs && \
    chown -r appuser:appuser /app

# Copy and make entrypoint executable
COPY docker/entrypoint.prod.sh /app/docker/entrypoint.prod.sh
RUN chmod +x /app/docker/entrypoint.prod.sh

USER appuser

EXPOSE 8080

# Use the entrypoint script
ENTRYPOINT ["/app/docker/entrypoint.prod.sh"]