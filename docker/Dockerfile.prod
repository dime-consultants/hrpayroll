FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip wheel --no-deps --wheel-dir /build/wheels -r requirements.txt

# ====================== Final Stage ======================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=hr_payroll.settings

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -r appuser && useradd -r -g appuser appuser

# Install Python packages from wheels
COPY --from=builder /build/wheels /wheels
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels

# Copy project code
COPY . .

# Create necessary directories and fix permissions
RUN mkdir -p /app/staticfiles /app/media /app/logs && \
    chown -R appuser:appuser /app

# Copy and make entrypoints executable
COPY docker/entrypoint.prod.sh /app/docker/entrypoint.prod.sh
COPY docker/entrypoint.celery.sh /app/docker/entrypoint.celery.sh
RUN chmod +x /app/docker/entrypoint.prod.sh /app/docker/entrypoint.celery.sh

USER appuser

EXPOSE 8080

# Use the entrypoint script
ENTRYPOINT ["/app/docker/entrypoint.prod.sh"]


import psycopg2, os
print('DB_NAME:', repr(os.environ.get('DB_NAME')))
print('DB_USER:', repr(os.environ.get('DB_USER')))
print('DB_PASSWORD:', repr(os.environ.get('DB_PASSWORD')))
print('DB_HOST:', repr(os.environ.get('DB_HOST')))
print('DB_PORT:', repr(os.environ.get('DB_PORT')))
try:
    conn = psycopg2.connect(
        dbname=os.environ['DB_NAME'],
        user=os.environ['DB_USER'],
        password=os.environ['DB_PASSWORD'],
        host=os.environ['DB_HOST'],
        port=os.environ.get('DB_PORT', '5432')
    )
    print('PSYCOPG2 CONNECTION SUCCESS')
    conn.close()
except Exception as e:
    print('PSYCOPG2 CONNECTION FAILED:', repr(e))
    raise
